---
import { SITE } from '../consts';
import Logo from './Logo.astro';
import RocketMark from './RocketMark.astro';
---
<section class="section cta" aria-labelledby="cta-h">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap inner reveal">
    <div class="mark"><RocketMark size={88} /></div>
    <h2 id="cta-h" class="sr-only">Get PewPew</h2>
    <Logo size="xl" />
    <p class="lede">Free on iPhone, with no ads, no account, and no in-app purchases. It plays offline.</p>
    <div class="ctas">
      <a class="badge" href={SITE.appStore} rel="noopener" aria-label="Download PewPew on the App Store">
        <img src="/app-store-badge.svg" alt="" width="180" height="60" loading="lazy" />
      </a>
      <a class="btn btn-magenta" href={SITE.github} rel="noopener">Star on GitHub</a>
    </div>
  </div>
</section>

<style>
  .cta { overflow: hidden; text-align: center; }
  .glow { position: absolute; inset: 10% -10% -30%; z-index: -1; background: radial-gradient(40% 50% at 50% 60%, rgba(255, 61, 154, 0.22), transparent 70%), radial-gradient(30% 40% at 50% 40%, rgba(53, 240, 255, 0.18), transparent 70%); }
  .inner { display: grid; justify-items: center; gap: 22px; }
  .mark { filter: drop-shadow(0 0 30px rgba(53, 240, 255, 0.6)); }
  @media (prefers-reduced-motion: no-preference) {
    .mark { animation: bob 3.2s ease-in-out infinite; }
    @keyframes bob { 50% { transform: translateY(-10px) rotate(2deg); } }
  }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px; margin-top: 6px; }
  .badge { display: block; border-radius: 12px; transition: transform 140ms ease, filter 140ms ease; }
  .badge img { height: 54px; width: auto; }
  .badge:hover { transform: translateY(-2px); filter: drop-shadow(0 8px 24px rgba(53, 240, 255, 0.35)); }
  .ctas .btn { min-height: 54px; }
</style>
