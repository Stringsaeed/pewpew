---
import { SITE } from '../consts';
import Demo from './Demo.astro';
import Logo from './Logo.astro';
---
<section class="hero" id="play">
  <canvas class="backdrop" data-backdrop aria-hidden="true"></canvas>
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">Free on iPhone · No ads · Plays offline</p>
      <Logo size="xl" as="h1" />
      <p class="tag">30 LEVELS. 3 BOSSES. ONE ROCKET.</p>
      <p class="lede">
        Thread a neon rocket through asteroid fields, minefields, drone swarms, and gravity wells, then dive into the black hole.
        Every pixel is drawn by WebGPU and every note is synthesized live. The game on the right is the real one, running in your browser.
      </p>
      <div class="ctas">
        <a class="badge" href={SITE.appStore} rel="noopener" aria-label="Download PewPew on the App Store">
          <img src="/app-store-badge.svg" alt="" width="180" height="60" />
        </a>
        <a class="btn" href={SITE.github} rel="noopener">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          Open source
        </a>
      </div>
      <ul class="stack" aria-label="Built with">
        <li><b class="c">WebGPU</b> render</li>
        <li><b class="m">Reanimated 4</b> UI</li>
        <li><b class="y">Audio API</b> synth</li>
        <li><b class="g">Argent</b> agent QA</li>
      </ul>
    </div>
    <Demo />
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; padding: clamp(40px, 7vw, 96px) 0 clamp(64px, 9vw, 120px); overflow: hidden; }
  .backdrop {
    position: absolute; inset: -64px 0 0; width: 100%; height: calc(100% + 64px); z-index: -1;
    mask-image: linear-gradient(#000 70%, transparent);
    background: radial-gradient(60% 50% at 70% 40%, rgba(42, 20, 80, 0.8), transparent 70%), var(--bg);
  }
  .grid { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: clamp(32px, 5vw, 72px); }
  .copy { display: grid; justify-items: start; gap: 20px; }
  .copy .eyebrow { margin: 0; color: var(--text-dim); }
  .tag { margin: 0; font-size: clamp(13px, 1.3vw, 16px); letter-spacing: 0.35em; color: var(--magenta); text-shadow: 0 0 14px rgba(255, 61, 154, 0.6); }
  .lede { color: var(--text-dim); }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 8px; }
  .badge { display: block; border-radius: 12px; transition: transform 140ms ease, filter 140ms ease; }
  .badge img { height: 54px; width: auto; }
  .badge:hover { transform: translateY(-2px); filter: drop-shadow(0 8px 24px rgba(53, 240, 255, 0.35)); }
  .ctas .btn { min-height: 54px; }
  .stack { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 12px; letter-spacing: 0.12em; color: var(--dim); text-transform: uppercase; }
  .stack b { font-weight: 700; }
  .c { color: var(--cyan); } .m { color: var(--magenta); } .y { color: var(--yellow); } .g { color: var(--green); }
  @media (max-width: 900px) {
    .grid { grid-template-columns: 1fr; }
    .copy { justify-items: center; text-align: center; }
    .ctas, .stack { justify-content: center; }
  }
</style>
