---
import Base from './Base.astro';

interface Props { title: string; description: string; eyebrow: string }
const { title, description, eyebrow } = Astro.props;
---
<Base title={title} description={description}>
  <article class="doc wrap">
    <p class="eyebrow">{eyebrow}</p>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .doc { max-width: 760px; padding-block: clamp(48px, 8vw, 110px) clamp(80px, 10vw, 140px); }
  .prose { color: var(--text-dim); font-size: 16px; line-height: 1.75; text-wrap: pretty; }
  .prose :global(h1) { margin: 0 0 28px; color: var(--text); font-size: clamp(34px, 5vw, 54px); line-height: 1.08; letter-spacing: 0.02em; text-wrap: balance; }
  .prose :global(h1 + p) { color: var(--yellow); font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; }
  .prose :global(h2) { margin: 52px 0 12px; padding-top: 24px; border-top: 1px solid var(--line); color: var(--cyan); font-size: 15px; letter-spacing: 0.25em; text-transform: uppercase; text-shadow: 0 0 16px rgba(53, 240, 255, 0.4); }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(li::marker) { color: var(--magenta); }
  .prose :global(strong) { color: var(--text); }
</style>
