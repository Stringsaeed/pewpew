{
  "name": "pewpew",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webgpu": "0.5.17",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/node": "26.6.5",
    "@types/react": "~19.2.2",
    "@webgpu/types": "0.1.65",
    "babel-preset-expo": "~57.0.14",
    "tsx": "4.23.15",
    "typegpu": "0.12.7",
    "typescript": "~6.0.3",
    "unplugin-typegpu": "0.12.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./scripts/typegpu-hooks.mjs --test \"src/**/*.test.ts\"",
    "verify": "tsx scripts/verify-levels.ts",
    "check": "npm run typecheck && npm test && npm run verify && npm run gen:meshes -- --check",
    "gen:meshes": "tsx scripts/gen-meshes.ts",
    "render-song": "tsx scripts/render-song.ts",
    "sweep": "tsx scripts/ramp-sweep.ts",
    "bench": "NODE_OPTIONS=--jitless tsx --import ./scripts/typegpu-hooks.mjs scripts/bench.ts",
    "perf:device": "tsx scripts/perf-device.ts",
    "gen:shaders": "tsx --import ./scripts/typegpu-hooks.mjs scripts/gen-shaders.ts"
  },
  "private": true
}
